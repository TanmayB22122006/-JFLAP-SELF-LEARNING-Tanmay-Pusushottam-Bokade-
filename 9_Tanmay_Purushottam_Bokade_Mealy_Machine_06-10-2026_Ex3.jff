<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 7.1.--><structure>
  <type>mealy</type>
  <automaton>
    <state id="0" name="q0">
      <x>150</x>
      <y>250</y>
      <initial/>
    </state>
    <state id="1" name="q1">
      <x>350</x>
      <y>250</y>
    </state>
    <transition>
      <from>0</from>
      <to>0</to>
      <read>0</read>
      <transout>E</transout>
    </transition>
    <transition>
      <from>0</from>
      <to>1</to>
      <read>1</read>
      <transout>O</transout>
    </transition>
    <transition>
      <from>1</from>
      <to>1</to>
      <read>0</read>
      <transout>O</transout>
    </transition>
    <transition>
      <from>1</from>
      <to>0</to>
      <read>1</read>
      <transout>E</transout>
    </transition>
    <note>
      <text>Q3: Mealy Machine - Output 'E' for Even 1s and 'O' for Odd 1s</text>
      <x>50.0</x>
      <y>50.0</y>
    </note>
    <note>
      <text>Designed by: Tanmay Purushottam Bokade (Roll No: 9)</text>
      <x>50.0</x>
      <y>100.0</y>
    </note>
  </automaton>
</structure>