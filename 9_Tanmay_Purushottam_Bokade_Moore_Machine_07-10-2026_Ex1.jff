<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 7.1.--><structure>
  <type>moore</type>
  <automaton>
    <state id="0" name="q0">
      <x>100</x>
      <y>250</y>
      <initial/>
      <output></output>
    </state>
    <state id="1" name="q1">
      <x>250</x>
      <y>150</y>
      <output>1</output>
    </state>
    <state id="2" name="q2">
      <x>250</x>
      <y>350</y>
      <output>0</output>
    </state>
    <transition>
      <from>0</from>
      <to>1</to>
      <read>0</read>
    </transition>
    <transition>
      <from>0</from>
      <to>2</to>
      <read>1</read>
    </transition>
    <transition>
      <from>1</from>
      <to>1</to>
      <read>0</read>
    </transition>
    <transition>
      <from>1</from>
      <to>2</to>
      <read>1</read>
    </transition>
    <transition>
      <from>2</from>
      <to>1</to>
      <read>0</read>
    </transition>
    <transition>
      <from>2</from>
      <to>2</to>
      <read>1</read>
    </transition>
    <note>
      <text>Q1: Moore Machine - 1's Complement of a binary string</text>
      <x>50.0</x>
      <y>50.0</y>
    </note>
    <note>
      <text>Designed by: Tanmay Purushottam Bokade (Roll No: 9)</text>
      <x>50.0</x>
      <y>100.0</y>
    </note>
